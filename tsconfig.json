{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strictNullChecks": true,
    "noImplicitThis": true
  },
  "exclude": [
    "supabase/functions",
    "back-order-dashboard",
    "scratch",
    "streamlit_apps",
    "dist",
    "node_modules",
    "_fix_all.js",
    "check_schema.js",
    "init_db.js",
    "log_profiles.js",
    "decode-sourcemap.cjs",
    "generate-docx.js",
    "utils/searchLogic.backup_v1.ts"
  ]
}