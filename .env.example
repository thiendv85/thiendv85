# Copy to .env.local and fill values. See README for details.

# Supabase project — required
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# Optional. AI Consultant calls supabase/functions/gemini-proxy.
# Set GEMINI_API_KEY as a Supabase Edge Function secret (NOT here):
#   supabase secrets set GEMINI_API_KEY=...
